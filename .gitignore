# Whitelist: everything is ignored except what is needed to reproduce the results
/*
!/R/
!/data/
!/docs/
!/outputs/
!/README.md
!/renv.lock
!/dengue_vacina_tak003.Rproj
!/.gitignore
!/.Rprofile

# data: lists, SI-PNI aggregates, state-year aggregates and the two SIH aggregates
/data/*
!/data/raw/
!/data/interim/
!/data/processed/
/data/raw/*
!/data/raw/lists/
!/data/raw/sipni/
/data/raw/sipni/tmp/
/data/raw/lists/dengue_vaccine_municipalities.csv
/data/processed/*
!/data/processed/sih_birth_cohort_aggregate.rds
!/data/processed/sih_controls_aggregate.rds

# reference numbers checked by script 99
/docs/*
!/docs/reference/

# outputs are regenerated; only the (resumable) permutation draws are kept
/outputs/*
!/outputs/models/
/outputs/models/*
!/outputs/models/permutation_*.csv
!/outputs/models/spatial_permutation_*.csv
